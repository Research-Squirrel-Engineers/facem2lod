<http://w3id.org/facem/ontology/>
    a owl:Ontology ;
    dct:description "Classes and properties for the FACEM fabrics of African Red Slip Ware as Linked Open Data. Every class is anchored in CIDOC-CRM or one of its extensions; terms of other vocabularies are reused by IRI, nothing is imported."@en ;
    dct:title "facem2lod ontology"@en ;
    owl:versionInfo "0.1" ;
    rdfs:seeAlso <https://github.com/Research-Squirrel-Engineers/facem2lod> .

facem:DatingAssignment
    a owl:Class ;
    rdfs:comment "The dating of a sherd: the original text, a period concept and a derived interval."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Dating assignment"@en ;
    rdfs:subClassOf crm:E13_Attribute_Assignment .

facem:Dimension
    a owl:Class ;
    rdfs:comment "A measured dimension of a sherd (diameter, height) with value and unit."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Dimension"@en ;
    rdfs:subClassOf crm:E54_Dimension .

facem:Image
    a owl:Class ;
    rdfs:comment "A photograph, thin-section image or drawing on facem.at."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Image"@en ;
    rdfs:subClassOf crm:E36_Visual_Item .

facem:ObservableProperty
    a owl:Class ;
    rdfs:comment "A property that is observed on a sample (colour of the fresh break, a kind of inclusion)."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Observable property"@en ;
    rdfs:subClassOf crmsci:S9_Property_Type ,
        sosa:ObservableProperty .

facem:Observation
    a owl:Class ;
    rdfs:comment "An observation of a sample: visual examination, binocular observation or thin section."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Observation"@en ;
    rdfs:subClassOf crmsci:S4_Observation ,
        sosa:Observation .

facem:Person
    a owl:Class ;
    rdfs:comment "A person named in the FACEM records (who took a sample, who analysed it)."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf crm:E21_Person .

facem:Place
    a owl:Class ;
    rdfs:comment "A place of the FACEM map, with a coordinate and, where decided, a link to Wikidata."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Place"@en ;
    rdfs:subClassOf crm:E53_Place ,
        geo:Feature .

facem:Production
    a owl:Class ;
    rdfs:comment "The supposed production of the sherds of one fabric at one place."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Production"@en ;
    rdfs:subClassOf crm:E12_Production .

facem:Publication
    a owl:Class ;
    rdfs:comment "A publication that documents the sherd, an assignment or an analysis."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Publication"@en ;
    rdfs:subClassOf crm:E31_Document .

facem:Sample
    a owl:Class ;
    rdfs:comment "A sample taken from a sherd for the analysis of the fabric."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Sample"@en ;
    rdfs:subClassOf crmsci:S13_Sample ,
        sosa:Sample .

facem:SampleTaking
    a owl:Class ;
    rdfs:comment "The removal of a sample from a sherd."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Sample taking"@en ;
    rdfs:subClassOf crmsci:S2_Sample_Taking .

facem:Sherd
    a owl:Class ;
    rdfs:comment "A sherd of pottery with its FACEM description: form, type, dimensions, chronology."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Sherd"@en ;
    rdfs:subClassOf crm:E22_Human-Made_Object .

facem:SourceRecord
    a owl:Class ;
    rdfs:comment "The FACEM page a statement comes from, with its address and the hash of the stored copy."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Source record"@en ;
    rdfs:subClassOf crm:E73_Information_Object ,
        geolod:DataSource .

facem:Survey
    a owl:Class ;
    rdfs:comment "A survey in which the sherds were found, with the place and the year."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Survey"@en ;
    rdfs:subClassOf crm:E7_Activity .

facem:TypeAssignment
    a owl:Class ;
    rdfs:comment "The assignment of a sherd to a concept of a typology (Hayes, Atlante, El Mahrine, Fulford, PM)."@en ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "Type assignment"@en ;
    rdfs:subClassOf crm:E13_Attribute_Assignment .

facem:alternativeTo
    a owl:ObjectProperty ;
    rdfs:comment "Two assignments written with a slash inside one typology (Hayes 61A/B4)."@en ;
    rdfs:domain facem:TypeAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "alternative to"@en ;
    rdfs:range facem:TypeAssignment .

facem:catalogueReference
    a owl:DatatypeProperty ;
    rdfs:comment "The place in the publication, for example 'cat. Bd.040, pl. 3'."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "catalogue reference"@en ;
    rdfs:range xsd:string .

facem:chronologyText
    a owl:DatatypeProperty ;
    rdfs:comment "The chronology exactly as written in FACEM."@en ;
    rdfs:domain facem:DatingAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "chronology text"@en ;
    rdfs:range xsd:string .

facem:colour
    a owl:ObjectProperty ;
    rdfs:comment "The colour of the inclusions."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "colour"@en ;
    rdfs:range skos:Concept .

facem:concordantWith
    a owl:ObjectProperty ;
    rdfs:comment "Two assignments written with a slash across typologies (Hayes 76/EM 10.1)."@en ;
    rdfs:domain facem:TypeAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "concordant with"@en ;
    rdfs:range facem:TypeAssignment .

facem:contextInterpretation
    a owl:ObjectProperty ;
    rdfs:comment "How FACEM interprets the context (production)."@en ;
    rdfs:domain facem:Survey ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "interpretation of the context"@en ;
    rdfs:range skos:Concept .

facem:contextRegistration
    a owl:DatatypeProperty ;
    rdfs:comment "The text of FACEM, for example 'surveyed in 1968'."@en ;
    rdfs:domain facem:Survey ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "registration of the context"@en ;
    rdfs:range xsd:string .

facem:decoration
    a owl:DatatypeProperty ;
    rdfs:comment "The description of the decoration, as written in FACEM."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "decoration"@en ;
    rdfs:range xsd:string .

facem:dimensionKind
    a owl:ObjectProperty ;
    rdfs:comment "What was measured."@en ;
    rdfs:domain facem:Dimension ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "kind of dimension"@en ;
    rdfs:range skos:Concept .

facem:dimensionPart
    a owl:ObjectProperty ;
    rdfs:comment "The part of the sherd the dimension refers to (rim, base)."@en ;
    rdfs:domain facem:Dimension ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "part measured"@en ;
    rdfs:range skos:Concept .

facem:fragmentation
    a owl:ObjectProperty ;
    rdfs:comment "The preserved part of the vessel."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "fragmentation"@en ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf crm:P2_has_type .

facem:frequency
    a owl:ObjectProperty ;
    rdfs:comment "How frequent the inclusions are."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "frequency"@en ;
    rdfs:range skos:Concept .

facem:imageRole
    a owl:DatatypeProperty ;
    rdfs:comment "What the image shows: macro, thin_section or drawing."@en ;
    rdfs:domain facem:Image ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "image role"@en ;
    rdfs:range xsd:string .

facem:imageUrl
    a owl:DatatypeProperty ;
    rdfs:comment "The address of the image on facem.at."@en ;
    rdfs:domain facem:Image ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "image address"@en ;
    rdfs:range xsd:anyURI .

facem:intervalRule
    a owl:DatatypeProperty ;
    rdfs:comment "Identifier of the rule that turned the chronology text into the begin and end years of the time-span."@en ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "interval rule"@en ;
    rdfs:range xsd:string .

facem:intervalUncertain
    a owl:DatatypeProperty ;
    rdfs:comment "True if the chronology text carries a question mark or a plus."@en ;
    rdfs:domain crm:E52_Time-Span ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "interval uncertain"@en ;
    rdfs:range xsd:boolean .

facem:objectForm
    a owl:ObjectProperty ;
    rdfs:comment "The form of the vessel."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "object form"@en ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf crm:P2_has_type .

facem:periodConcept
    a owl:ObjectProperty ;
    rdfs:comment "The period concept named in the chronology."@en ;
    rdfs:domain facem:DatingAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "period"@en ;
    rdfs:range skos:Concept .

facem:primarySource
    a owl:ObjectProperty ;
    rdfs:comment "The FACEM page the description of the sherd comes from."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "primary source"@en ;
    rdfs:range facem:SourceRecord ;
    rdfs:subPropertyOf crm:P70i_is_documented_in .

facem:registrationCode
    a owl:DatatypeProperty ;
    rdfs:comment "The registration code of the object in the survey."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "registration code"@en ;
    rdfs:range xsd:string .

facem:representativeSampleOf
    a owl:ObjectProperty ;
    rdfs:comment "Marks the sample that FACEM calls the representative sample of a fabric."@en ;
    rdfs:domain facem:Sample ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "representative sample of"@en ;
    rdfs:range skos:Concept .

facem:resultConcept
    a owl:ObjectProperty ;
    rdfs:comment "The result of an observation that is a vocabulary term."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "result (concept)"@en ;
    rdfs:range skos:Concept .

facem:roundness
    a owl:ObjectProperty ;
    rdfs:comment "The roundness of the inclusions."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "roundness"@en ;
    rdfs:range skos:Concept .

facem:sha256
    a owl:DatatypeProperty ;
    rdfs:comment "The hash of the stored copy of the page (data/raw/harvest_manifest.json)."@en ;
    rdfs:domain facem:SourceRecord ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "sha256"@en ;
    rdfs:range xsd:string .

facem:shape
    a owl:ObjectProperty ;
    rdfs:comment "The shape of the inclusions."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "shape"@en ;
    rdfs:range skos:Concept .

facem:sizeMax
    a owl:DatatypeProperty ;
    rdfs:comment "Highest length of the inclusions, in millimetres."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "highest size"@en ;
    rdfs:range xsd:decimal .

facem:sizeMin
    a owl:DatatypeProperty ;
    rdfs:comment "Lowest length of the inclusions, in millimetres."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "lowest size"@en ;
    rdfs:range xsd:decimal .

facem:sourcePage
    a owl:DatatypeProperty ;
    rdfs:comment "The address of the FACEM page."@en ;
    rdfs:domain facem:SourceRecord ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "source page"@en ;
    rdfs:range xsd:anyURI .

facem:supposedPlace
    a owl:ObjectProperty ;
    rdfs:comment "The supposed place of a production; FACEM calls it 'supposed site of production'."@en ;
    rdfs:domain facem:Production ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "supposed place"@en ;
    rdfs:range facem:Place ;
    rdfs:subPropertyOf crm:P7_took_place_at .

facem:surface
    a owl:ObjectProperty ;
    rdfs:comment "The surface treatment."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "surface"@en ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf crm:P2_has_type .

facem:typeCertainty
    a owl:ObjectProperty ;
    rdfs:comment "How certain the assignment is, in the words of FACEM (certain, possible, uncertain, similar)."@en ;
    rdfs:domain facem:TypeAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "certainty"@en ;
    rdfs:range skos:Concept .

facem:typeQualifier
    a owl:ObjectProperty ;
    rdfs:comment "A qualifier of the type, such as 'late' or 'no. 1'."@en ;
    rdfs:domain facem:TypeAssignment ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "qualifier"@en ;
    rdfs:range skos:Concept .

facem:valueMax
    a owl:DatatypeProperty ;
    rdfs:comment "The highest value of a range result (the same as the lowest if there is one value)."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "highest value"@en ;
    rdfs:range xsd:decimal .

facem:valueMin
    a owl:DatatypeProperty ;
    rdfs:comment "The lowest value of a range result."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "lowest value"@en ;
    rdfs:range xsd:decimal .

facem:valueUnit
    a owl:ObjectProperty ;
    rdfs:comment "The unit of valueMin and valueMax, a QUDT unit."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "unit"@en ;
    rdfs:range qudt:Unit .

facem:voidForm
    a owl:ObjectProperty ;
    rdfs:comment "The form of the voids."@en ;
    rdfs:domain facem:Observation ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "void form"@en ;
    rdfs:range skos:Concept .

facem:ware
    a owl:ObjectProperty ;
    rdfs:comment "The ware of a sherd."@en ;
    rdfs:domain facem:Sherd ;
    rdfs:isDefinedBy <http://w3id.org/facem/ontology/> ;
    rdfs:label "ware"@en ;
    rdfs:range skos:Concept ;
    rdfs:subPropertyOf crm:P2_has_type .

